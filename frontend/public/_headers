# Cloudflare Pages — cache de assets estáticos
# HTML fica sem cache longo (max-age=0 padrão do Pages).
# Arquivos com hash no nome (/assets/*-XXXX.js|css) e mídia em /assets/ e /fonts/
# podem cachear agressivamente; o hash/path muda no deploy.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
