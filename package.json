{
  "name": "karina-art-tatoo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names FRONTEND,BACKEND --prefix-colors magenta,cyan \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "check": "npm run check --workspace backend",
    "start": "npm run start --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "admin:hash": "npm run admin:hash --workspace backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "10.0.4"
  },
  "overrides": {
    "postcss": "8.5.25",
    "tar": "7.5.22"
  }
}
