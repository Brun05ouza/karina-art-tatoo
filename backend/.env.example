NODE_ENV=development
HOST=127.0.0.1
PORT=3333

# Origens autorizadas, separadas por vírgula. Nunca use *.
CORS_ORIGINS=http://localhost:5174,https://karinasarte.com.br

# Autenticação do painel e integrações servidor-servidor.
# Gere o hash e os segredos com: npm run admin:hash -- --all
ADMIN_EMAIL=admin@karinasarte.com.br
ADMIN_PASSWORD_HASH=scrypt:65536:8:1:32:COLE_O_SALT:COLE_O_HASH
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters

# Acesso rápido estritamente local. O backend recusa esta opção em produção.
DEV_ADMIN_ENABLED=false
DEV_ADMIN_EMAIL=dev@karinasarte.local
DEV_ADMIN_PASSWORD=replace-with-a-local-password

# Neon — opcional no boot; necessário para /api/content e /api/media.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Cloudflare R2 — opcional no boot; necessário para uploads.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=karina-sarte-media
# R2_PUBLIC_BASE_URL=https://media.karinasarte.com.br
