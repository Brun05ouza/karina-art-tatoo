    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
